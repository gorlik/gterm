SDCCROOT = /mnt/share/local/sdcc-460/bin
SDCC = $(SDCCROOT)/sdcc
SDAS = $(SDCCROOT)/sdas6500
MAKEBIN = $(SDCCROOT)/makebin

SDKROOT = ~/gglabs/retro/sdcc-sdk/sdcc-6502-sdk
TARGET = -mmos6502 -D__C64__
SDCCOPT=--max-allocs-per-node 25000 --opt-code-speed
SDCCDEBUG=--fverbose-asm --i-code-in-asm
SDKINC = -I $(SDKROOT)/include

VPATH=../src:../src/sdcc
INCLUDE=../src
SYS_INCLUDE=../src
CART = --code-loc 0x8000 --xram-loc 0x1000 --data-loc 0x0002 $(SDKROOT)/lib/c64_cart_crt0.rel
PRG = --code-loc 0x7ff --xram-loc 0x8000 --data-loc 0x0002 $(SDKROOT)/lib/c64_prg_crt0.rel
LIBS = -l c64.lib

CFLAGS = $(TARGET) $(SDCCOPT) $(SDKINC)
LDFLAGS = -L $(SDKROOT)/lib --out-fmt-ihx -mmos6502 --no-std-crt0

CFLAGS += -I. -I$(INCLUDE) -I$(SYS_INCLUDE)

OBJECTS=  vt100_escape.rel acia_recv.rel putchar80.rel scroll.rel \
	variables.rel char_tables.rel soft80-font.rel

gterm.bin: $(OBJECTS)

clean:
	rm -f *.ihx *.rel *.map *.noi *.asm *.lk *.sym *.lst

.PRECIOUS: %.rel %.ihx

#char_tables.rel: char_tables.c
#	$(SDCC) $(CFLAGS) --constseg TABLES -c -o $@ $<

#soft80-font.rel: soft80-font.c
#	$(SDCC) $(CFLAGS) --constseg TABLES -c -o $@ $<

#vt100-escape.rel: vt100-escape.c
#	$(SDCC) $(CFLAGS) --no-zp-spill -c -o $@ $<

%.bin: %.rel $(OBJECTS)
	$(SDCC) $(LDFLAGS) $(CART) $(LIBS) $(OBJECTS) -Wl-bTABLES=0xb600 $< -o $@.ihx
#	$(SDCC) $(LDFLAGS) $(CART) $(LIBS) $(OBJECTS) -Wl-bTABLES=0xb600 -Wl-bOSEG=0xf7 $< -o $@.ihx
	$(MAKEBIN) -o 0x8000 -s 0xc000 $@.ihx $@


%.prg: %.rel $(OBJECTS)
	$(SDCC) $(LDFLAGS) $(PRG) $(LIBS) $(OBJECTS) $< -o $@.ihx
	$(MAKEBIN) -o 0x7ff -s 0xd000 -p $@.ihx $@

%.rel: %.c
	$(SDCC) $(CFLAGS) -c -o $@ $<

%.rel: %.s
	$(SDAS) -jxlosp $@ $<
